DISCORD_TOKEN= #Token
DISCORD_PREFIX=. # Discord bot prefix (default: .)
PTERODACTYL_API_URL= #PTERODACTYL_API_URL (leave blank to use CRAFTY only)
PTERODACTYL_API_KEY= #PTERODACTYL_API_KEY
FOLDER_NAMES= #satisfactory,minecraft
FOLDER_PATHS= #E:/Desktop/satisfactory/Saved,E:/Desktop/minecraft/world
TZ= #"Asia/Colombo"
BACKUP_TIME= #04:20
SHUTDOWN_BEFORE_BACKUP=true
MAX_BACKUPS=0 # 0 = Keep all backups. > 0 = Keep latest N backups.
ENABLE_DRIVE_BACKUP=true # true = Backup to Google Drive and local. false = Local backup only.
CRAFTY_API_URL= # e.g. https://192.168.1.10:8111 (leave blank to use Pterodactyl only)
CRAFTY_API_KEY= # API token from Crafty Controller user settings