
#              DISCORD BOT

DISCORD_TOKEN= # Discord bot token
DISCORD_PREFIX=. # Discord bot prefix (default: .)
DISCORD_NOTIFY_CHANNEL= # Optional: Channel ID to send system alerts (e.g. Drive disconnected warnings)

#             PANEL API KEYS

# Pterodactyl (Leave blank to use Crafty only)
PTERODACTYL_API_URL= # e.g. https://panel.yourdomain.com
PTERODACTYL_API_KEY= # Your Pterodactyl API Key

# Crafty Controller (Leave blank to use Pterodactyl only)
CRAFTY_API_URL= # e.g. https://panel.yourdomain.com
CRAFTY_API_KEY= # API token from Crafty Controller user settings

# Backup Schedule & Settings
TZ=Asia/Colombo # Your timezone
BACKUP_TIME=04:20 # Time for scheduled backup (24h format)
MAX_BACKUPS=0 # 0 = Keep all backups. > 0 = Keep latest N local backups.
MAX_DRIVE_BACKUPS=0 # 0 = Keep all backups. > 0 = Keep latest N Google Drive backups.
SHUTDOWN_BEFORE_BACKUP=true # true = Safely shutdown game servers before backup

#         GOOGLE DRIVE INTEGRATION

# Note: You can upload your credentials.json and connect via the Web Dashboard.
ENABLE_DRIVE_BACKUP=true # true = Backup to Google Drive AND local. false = Local backup only.